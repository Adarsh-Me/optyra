# DevOps-owned production environment (copy to deploy/.env, chmod 600).
# App-level vars (GH_TOKEN, TELEGRAM_*, AI_*) are documented in the root .env.example.

# Image to run; the release workflow pushes tags to GHCR.
OPTYRA_IMAGE=ghcr.io/CHANGE_ME/optyra:latest

# Postgres credentials used by both services.
POSTGRES_USER=optyra
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=optyra

# App secrets (same meaning as root .env.example).
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
LOG_LEVEL=INFO
LOG_JSON=1
HEALTHCHECK_URL=
