# ─────────────────────────────────────────────────────────────────────────────
# Optyra environment contract (report 02prd §6 — "the entire contract between
# your two roles"). Copy to .env and fill in. NEVER commit real .env files.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub: fine-grained PAT on your main account, "Public repositories (read-only)",
# no extra permissions. Rotate every 90 days (runbook.md). REQUIRED.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Telegram: token from @BotFather + your numeric chat id (comma-separate for multiple
# allowlisted chats). REQUIRED for notifications; the worker refuses strangers anyway.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# PostgreSQL. In deploy/docker-compose.yml the worker reaches Postgres at host
# "postgres"; for bare-metal local dev use localhost. REQUIRED.
DATABASE_URL=postgresql+asyncpg://optyra:optyra@postgres:5432/optyra

# Gemini Flash via Google AI Studio (https://aistudio.google.com/apikey). Free tier is
# enough at 20-80 candidate calls/day. Optional: leave empty to disable AI summaries.
AI_API_KEY=
# Model override (defaults to config.yaml ai.model); swap models without code changes.
AI_MODEL=gemini-2.0-flash

# Path to the directory containing config.yaml / orgs.yaml / ai_criteria.yaml.
CONFIG_PATH=config

# Logging: DEBUG | INFO | WARNING | ERROR; LOG_JSON=1 for JSON lines (production).
LOG_LEVEL=INFO
LOG_JSON=0

# Healthchecks.io ping URL (dead-man switch, report §16). Empty disables.
HEALTHCHECK_URL=
